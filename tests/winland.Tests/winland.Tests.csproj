<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for winland's pure logic (strip layout, tile ordering). Nothing here touches real
       windows, so the tests run anywhere the SDK does — no elevation, no desktop session needed. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Winland.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\winland\winland.csproj" />
  </ItemGroup>

</Project>
