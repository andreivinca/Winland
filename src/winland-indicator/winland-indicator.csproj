<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Deliberately no ApplicationManifest: unlike winland and winland-keys the indicator runs asInvoker,
         and Winland starts it with the user's normal token. It reads workspace state off a pipe, draws,
         and asks for a workspace move over the user-accessible control pipe, so it never needs
         administrator rights. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>winland-indicator</AssemblyName>
    <Version>0.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winland.Common\Winland.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="winland-indicator.Tests" />
  </ItemGroup>

</Project>
