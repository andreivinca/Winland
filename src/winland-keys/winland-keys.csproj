<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>winland-keys</AssemblyName>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winland.Common\Winland.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="launch-or-focus.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="launch-web.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="show-desktop.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    The Super+number / focus / close / release binds run "winlandctl <verb>", which AppLauncher
    resolves to a winlandctl.exe sitting NEXT TO this daemon. Build winlandctl and copy its whole
    output (apphost .exe + .dll + runtimeconfig/deps) beside winland-keys.exe, so those binds work
    when running straight from this project's build folder — not only from a hand-assembled dist.
  -->
  <Target Name="CopyWinlandctl" AfterTargets="Build">
    <!--
      Build winlandctl framework-dependent (its own net10.0, no RID). RemoveProperties drops any
      RuntimeIdentifier/self-contained flags inherited from a `dotnet publish -r ...` of this project,
      which winlandctl isn't restored for and would otherwise fail on.
    -->
    <MSBuild Projects="..\winlandctl\winlandctl.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;PublishReadyToRun;PublishTrimmed">
      <Output TaskParameter="TargetOutputs" ItemName="_WinlandctlPrimaryOutput" />
    </MSBuild>
    <ItemGroup>
      <_WinlandctlFiles Include="%(_WinlandctlPrimaryOutput.RootDir)%(_WinlandctlPrimaryOutput.Directory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinlandctlFiles)"
          DestinationFiles="@(_WinlandctlFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
